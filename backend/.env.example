# Postgres connection string, with the PostGIS extension available. Example
# below is a Neon connection string (get this from the Neon dashboard) --
# any Postgres host works, but most hosted providers require SSL, hence
# ?sslmode=require.
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/localescore?sslmode=require

# OpenRouteService API key (free tier: https://openrouteservice.org/dev/#/signup)
ORS_API_KEY=

# Port the Express server listens on
PORT=8787

# Comma-separated list of origins allowed to call this API (your Vite dev
# server, and later your deployed frontend URL)
CORS_ORIGINS=http://localhost:5173
